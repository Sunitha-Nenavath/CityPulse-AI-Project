# Gemini API Key (Required for active Gemini classification and chat)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud / BigQuery Settings (Optional, falls back to local CSV if not set)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
BIGQUERY_PROJECT=your_gcp_project_id
BIGQUERY_DATASET=citypulse_dataset
BIGQUERY_TABLE=complaints
USE_BIGQUERY=false

